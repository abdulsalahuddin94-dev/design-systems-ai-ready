{
 "meta": {
  "platform": "Web",
  "source": "Templates page of Astryx Library DS (33 Example/* components), read 2026-10-06",
  "rule": "Screens are assembled only from components in component-registry.json and tokens in tokens.json. Use these as layout references for our projects; rebuild them with our DS components, at our screen sizes (Desktop 1440 / Mobile 375).",
  "frames_observed": "every template is 1920 x 1080 (no mobile versions); Color mode set explicitly to Neutral Light on each",
  "dark_mode": "set the Color mode (or a theme extension mode) on the frame; never duplicate components",
  "skills": [
   "figma-generate-design",
   "figma-use",
   "ui-ux-pro-max",
   "audit-design-system"
  ],
  "note": "Some templates still nest old XDSFieldLabel / XDSIcon parts through their TextInput instances (leftover names from the XDS library Astryx came from)."
 },
 "sections": {
  "Table": "Data tables with grouping, search, filters (PowerSearch), sorting and pagination",
  "Form": "Data entry forms: single column, two columns, checkout with order summary",
  "Settings": "Settings as a long form, inside a Dialog with Tabs, or as side-by-side panels",
  "Login": "Sign in: card, basic, split screen with image, SSO buttons",
  "Tools": "Dense app tools: page editor, file explorer, IDE layout, kanban board",
  "Content": "Content and commerce pages: order detail, documentation (catalog, design, technical), card grid, product detail",
  "AI Chat": "AI assistant: conversation with tool calls and code, landing with composer and suggestion cards",
  "Gallery": "Marketing and media: hero layouts and galleries with AspectRatio media",
  "Shell": "App shells with content slot: top nav + tree, side nav, top nav only"
 },
