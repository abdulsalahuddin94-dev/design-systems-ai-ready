{
  "note": "Figma component name -> React export that renders it. Used by tools/storybook_stories.py. 'example' adds a composed, interactive story.",
  "OTP / Cell": { "module": "FormElements", "export": "OTPCell" },
  "OTP / Field": { "module": "FormElements", "export": "OTPField" },
  "Stepper": { "module": "FormElements", "export": "Stepper" },
  "Input / Text": { "module": "FormElements", "export": "InputText" },
  "Input / URL": { "module": "FormElements", "export": "InputURL" },
  "Input / Card Number": { "module": "FormElements", "export": "InputCardNumber" },
  "Upload Field": { "module": "FormElements", "export": "UploadField" },
  "Search": { "module": "FormElements", "export": "Search" },
  "Menu / Item": { "module": "FormElements", "export": "MenuItem" },
  "Menu": { "module": "FormElements", "export": "Menu" },
  "Select / Dropdown": { "module": "FormElements", "export": "SelectDropdown" },
  "Textarea": { "module": "FormElements", "export": "Textarea" },
  "Checkbox": { "module": "FormElements", "export": "Checkbox" },
  "Toggle": { "module": "FormElements", "export": "Toggle" },
  "Radio": { "module": "FormElements", "export": "Radio" },
  "Button": { "module": "Navigation", "export": "Button", "matrix": ["Type", "State"] },
