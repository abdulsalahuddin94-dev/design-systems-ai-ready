  "Tabs / Item — Pill": { "module": "Navigation", "export": "TabPill", "example": "<Tabs Style=\"Pill\" />", "example_imports": ["Tabs"] },
  "Breadcrumb / Item": { "module": "Navigation", "export": "BreadcrumbItem" },
  "Breadcrumb": { "module": "Navigation", "export": "Breadcrumb" },
  "Avatar": { "module": "DataDisplay", "export": "Avatar", "matrix": ["Type", "Size"] },
  "Avatar Upload": { "module": "DataDisplay", "export": "AvatarUpload" },
  "Tooltip": { "module": "DataDisplay", "export": "Tooltip", "matrix": ["Size", "Arrow"] },
  "Alert": { "module": "DataDisplay", "export": "Alert" },
  "Badge": { "module": "DataDisplay", "export": "Badge" },
  "Toast": { "module": "DataDisplay", "export": "Toast" },
  "Confirmation Popup": { "module": "DataDisplay", "export": "ConfirmationPopup" }
