{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "design@knowledge-work-plugins": false
  },
  "permissions": {
    "allow": [
      "mcp__figma-console__figma_get_status",
      "mcp__figma-console__figma_list_open_files",
      "mcp__figma-console__figma_get_file_data",
      "mcp__figma-console__figma_get_variables",
      "mcp__figma-console__figma_get_token_values",
      "mcp__figma-console__figma_browse_tokens",
      "mcp__figma-console__figma_export_tokens",
      "mcp__figma-console__figma_get_styles",
      "mcp__figma-console__figma_get_text_styles",
      "mcp__figma-console__figma_search_components",
      "mcp__figma-console__figma_get_component",
      "mcp__figma-console__figma_get_component_details",
      "mcp__figma-console__figma_get_component_image",
      "mcp__figma-console__figma_get_component_for_development",
      "mcp__figma-console__figma_get_component_for_development_deep",
      "mcp__figma-console__figma_analyze_component_set",
      "mcp__figma-console__figma_get_design_system_summary",
      "mcp__figma-console__figma_get_design_system_kit",
      "mcp__figma-console__figma_get_library_components",
      "mcp__figma-console__figma_get_library_variables",
      "mcp__figma-console__figma_get_selection",
      "mcp__figma-console__figma_get_slots",
      "mcp__figma-console__figma_get_annotations",
      "mcp__figma-console__figma_get_comments",
      "mcp__figma-console__figma_get_file_versions",
      "mcp__figma-console__figma_get_design_changes",
      "mcp__figma-console__figma_get_changes_since_version",
      "mcp__figma-console__figma_diff_versions",
      "mcp__figma-console__figma_take_screenshot",
      "mcp__figma-console__figma_capture_screenshot",
      "mcp__figma-console__figma_audit_design_system",
      "mcp__figma-console__figma_audit_design_system_report",
      "mcp__figma-console__figma_audit_component_accessibility",
      "mcp__figma-console__figma_lint_design",
      "mcp__figma-console__figma_check_design_parity",
      "mcp__figma-console__figma_get_console_logs",
      "mcp__figma-console__figma_diagnose",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(python --version)",
      "Bash(python tools/build_tokens.py:*)",
      "Bash(python tools/new_foundation.py:*)",
      "Bash(python tools/project_status.py:*)",
      "Bash(npm run storybook:*)",
      "Bash(npm run build-storybook:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm create:*)",
      "Bash(npx storybook add:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(winget install:*)",
      "Bash(claude mcp add:*)",
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(gh repo create:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_absolute_paths.cjs\""
          }
        ]
      },
      {
        "matcher": "mcp__figma-console__figma_execute|mcp__figma-console__figma_execute_across_files|mcp__.*figma.*__use_figma",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_figma.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__figma-console__figma_(execute|create_.*|batch_.*|update_.*|delete_.*|set_.*|add_.*|edit_.*|rename_.*|move_.*|resize_.*|clone_.*|instantiate_.*|import_.*|arrange_.*|append_.*|reset_.*|setup_.*|audit_.*|lint_.*)|mcp__.*figma.*__use_figma|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_reminder.cjs\" mark"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_reminder.cjs\" stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/storybook_notice.cjs\""
          }
        ]
      }
    ]
  }
}
